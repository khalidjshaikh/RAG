# OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Model configuration (optional, shown defaults)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Chunking (optional, shown defaults)
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval (optional, shown defaults)
TOP_K=4
SIMILARITY_THRESHOLD=0.0
